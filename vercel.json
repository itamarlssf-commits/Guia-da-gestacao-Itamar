{
  "cleanUrls": true,
  "redirects": [
    { "source": "/",           "destination": "/guia-publico", "permanent": false },
    { "source": "/guia",       "destination": "/guia-publico", "permanent": false },
    { "source": "/index.html", "destination": "/guia-publico", "permanent": false },
    { "source": "/index",      "destination": "/guia-publico", "permanent": false }
  ],
  "headers": [
    {
      "source": "/guia-publico",
      "headers": [
        { "key": "X-Robots-Tag",  "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
